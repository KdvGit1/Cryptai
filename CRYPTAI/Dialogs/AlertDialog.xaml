<Window x:Class="CRYPTAI.AlertDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bilgilendirme" Height="200" Width="400"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Border x:Name="border1" Background="#CC1E222D" BorderBrush="#0ECB81" BorderThickness="1" CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.8"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="TxtIcon" Text="✅" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#0ECB81"/>
                <TextBlock x:Name="TxtTitle" Text="İŞLEM BAŞARILI" Foreground="#0ECB81" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock x:Name="TxtMessage" Grid.Row="1" TextWrapping="Wrap" TextAlignment="Center" 
                       VerticalAlignment="Center" Foreground="White" FontSize="14" Margin="0,10">
                İşlem başarıyla tamamlandı.
            </TextBlock>

            <Button x:Name="okButton" Content="TAMAM" Click="BtnOk_Click" Grid.Row="2"
                    Width="120" Height="35" Background="#0ECB81" Foreground="#1E222D"
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Border>
</Window>